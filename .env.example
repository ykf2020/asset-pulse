# 複製成 .env.local 後填入實際值（.env.local 不會進版控）
#
# ⚠️ 本機的 .env.local 與 Vercel 環境變數的格式「不一樣」：
#    - .env.local：值裡有換行，必須用雙引號包住（下面的寫法）
#    - Vercel 儀表板：輸入框是字面值，**不要加引號**，直接貼原始內容
#      （加了引號的話引號會變成金鑰的一部分，Google 會回
#       `DECODER routines::unsupported`）
#    程式對兩種格式都能處理，但照上面的規則最不容易出錯。

# ── Google Sheet ────────────────────────────────────────────────
# 試算表網址 https://docs.google.com/spreadsheets/d/<這一段>/edit
SHEET_ID=

# Service account 的 JSON 金鑰裡的 client_email
GOOGLE_SERVICE_ACCOUNT_EMAIL=asset-pulse@xxxx.iam.gserviceaccount.com

# JSON 金鑰裡 private_key 的值，原封不動照抄（換行就是字面上的 \n）
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ── App 解鎖 ────────────────────────────────────────────────────
# 用 `npm run pin` 產生這兩行
APP_PIN_HASH=
AUTH_SECRET=
